// Prisma schema for Family Tree Platform
// SQLite for local development — zero config, file-based
// Swap to PostgreSQL/MySQL by changing `provider` below

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── User (Auth) ──────────────────────────────────────────

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  familyName String?
  avatar     String?
  // P2-1 account states. Application domain values:
  // status: "pending" | "active" | "disabled" (see src/lib/account-states)
  // role:   "owner" | "member"
  status     String   @default("pending")
  role       String   @default("member")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notifications Notification[]
}

// ─── Notification (in-app, P2-1) ─────────────────────────
// Deliveries stay inside the server: no email, no external push.
// Known types: "ACCOUNT_PENDING_CREATED" | "ACCOUNT_ACTIVATED".

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  payloadJson String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Event (append-only store, P2-2) ─────────────────────
// Immutable audit log of meaningful account actions (ADR 0003).
// Append-only by convention: the server has exactly one writer
// (appendEvent in src/lib/events) and no update/delete route exists.
// actorUserId is NULL for system-initiated actions.
// familyTreeId is NULL for events not scoped to one tree.
// No foreign keys on purpose: the store must outlive referenced rows
// (records survive account deletion) and migrations stay additive.

model Event {
  id           String   @id @default(cuid())
  type         String
  actorUserId  String?
  familyTreeId String?
  payloadJson  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
  @@index([familyTreeId, createdAt])
}

// ─── Family Tree ──────────────────────────────────────────

model FamilyTree {
  id              String               @id @default(uuid())
  name            String
  description     String?
  memberCount     Int                  @default(0)
  generationCount Int                  @default(0)
  thumbnail       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  members         FamilyMember[]
  relationships   FamilyRelationship[]
}

// ─── Family Member ────────────────────────────────────────

model FamilyMember {
  id              String               @id @default(uuid())
  treeId          String
  name            String
  nickname        String?
  birthDate       String
  deathDate       String?
  birthPlace      String?
  currentLocation String?
  profession      String?
  education       String?
  gender          String               @default("male")
  photoUrl        String?
  email           String?
  phone           String?
  isAlive         Boolean              @default(true)
  // Per-individual sharing consent (S-06 Wave 1). Application domain
  // values: "shared" | "private". NULL means not yet recorded; the
  // export privacy gate treats NULL living members as redact.
  privacyStatus   String?
  generation      Int                  @default(1)
  maritalStatus   String               @default("single")
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tree              FamilyTree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  relationshipsFrom FamilyRelationship[] @relation("MemberFrom")
  relationshipsTo   FamilyRelationship[] @relation("MemberTo")

  @@index([treeId])
  @@index([generation])
}

// ─── Family Relationship ─────────────────────────────────

model FamilyRelationship {
  id        String   @id @default(uuid())
  treeId    String
  memberId  String
  relatedId String
  type      String
  createdAt DateTime @default(now())

  tree    FamilyTree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  member  FamilyMember @relation("MemberFrom", fields: [memberId], references: [id], onDelete: Cascade)
  related FamilyMember @relation("MemberTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([memberId, relatedId, type])
  @@index([treeId])
}
